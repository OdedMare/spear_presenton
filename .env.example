# Content Rewrite Configuration

# Maximum input tokens for content rewriting
# This controls how large each batch can be when processing presentations
# Default: 8000 (works for most models with 12k+ context)
# 
# Adjust this based on your model's context window:
# - Small models (4k context): 3000
# - Medium models (8-16k context): 6000-12000
# - Large models (32k+ context): 20000-28000
# - Very large models (100k+ context): 80000+
#
CONTENT_REWRITE_MAX_INPUT_TOKENS=8000
