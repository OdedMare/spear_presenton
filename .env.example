# ========================================
# AUTHENTICATION CONFIGURATION
# ========================================

# Enable/disable authentication requirement
# Set to "true" to require users to login with a username
# Set to "false" to allow anonymous access
# Default: false
REQUIRE_AUTH=false

# ========================================
# ELASTICSEARCH LOGGING CONFIGURATION
# ========================================

# Elasticsearch URL for centralized logging
# Example: http://elasticsearch:9200 or https://your-es-cluster.com:9200
# Leave empty to disable Elasticsearch logging (console logging will still work)
# Default: (empty - disabled)
ELASTICSEARCH_URL=

# Elasticsearch authentication (optional)
# Only required if your Elasticsearch cluster requires authentication
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# Elasticsearch index prefix
# Logs will be stored in indices named: {PREFIX}-YYYY.MM.DD
# Default: presenton-logs
ELASTICSEARCH_INDEX_PREFIX=presenton-logs

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# Disable SSL verification for Elasticsearch
# Set to "true" if using self-signed certificates
# Default: false
DISABLE_SSL_VERIFY=false

# ========================================
# CONTENT REWRITE CONFIGURATION
# ========================================

# Maximum input tokens for content rewriting
# This controls how large each batch can be when processing presentations
# Default: 8000 (works for most models with 12k+ context)
#
# Adjust this based on your model's context window:
# - Small models (4k context): 3000
# - Medium models (8-16k context): 6000-12000
# - Large models (32k+ context): 20000-28000
# - Very large models (100k+ context): 80000+
#
CONTENT_REWRITE_MAX_INPUT_TOKENS=8000
