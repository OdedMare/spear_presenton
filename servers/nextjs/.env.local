NEXT_PUBLIC_API_URL=http://localhost:8000

# Authentication
# Set to "true" to require users to login before accessing the app
NEXT_PUBLIC_REQUIRE_AUTH=true

# Elasticsearch Logging (server-side only - leave empty to disable)
# Example: http://elasticsearch:9200
ELASTICSEARCH_URL=
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=presenton-logs
LOG_LEVEL=INFO
